# Frontend environment variables (example — copy to .env.local and adjust)

# Base URL of the backend API. Only used when VITE_USE_MOCKS is false.
VITE_API_BASE_URL=http://localhost:8000/api

# When "true", the app uses the isolated in-repo mock data layer instead of
# real HTTP calls. This lets the UI be built before the backend API exists.
VITE_USE_MOCKS=true