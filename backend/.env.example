# Copy this file to .env and fill in real values for local development.
# .env is (and must remain) gitignored -- never commit real secrets.

FLASK_ENV=development

# Used to sign session cookies and as the JWT fallback secret if
# JWT_SECRET_KEY is unset. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Independent from SECRET_KEY on purpose -- see app/config.py for why.
JWT_SECRET_KEY=change-me-too-and-make-it-different-from-secret-key
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=86400

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agri_super_app

# Only used when running the test suite against real Postgres instead of
# the default in-memory SQLite (see app/config.py's TestingConfig).
TEST_DATABASE_URL=sqlite:///:memory:

# Comma-separated list of allowed browser origins for the SPA.
CORS_ORIGINS=http://localhost:3000

# Used to build the password reset link that's emailed to the user (see
# app/services/auth_service.py + email_service.py).
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRES_SECONDS=3600

# Real SMTP email delivery (app/services/email_service.py) -- currently
# used for password-reset emails. If MAIL_SERVER, MAIL_USERNAME, and
# MAIL_PASSWORD aren't ALL set, email is treated as "not configured":
# the app logs a clear server-side error and the forgot-password endpoint
# still returns its normal (anti-enumeration) response -- it never
# pretends an email was sent, but it also never reveals whether the
# requested address exists.
#
# Example values for Gmail (requires a 16-character App Password, not
# your normal password -- https://myaccount.google.com/apppasswords):
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=true
#   MAIL_USE_SSL=false
#   MAIL_USERNAME=your-address@gmail.com
#   MAIL_PASSWORD=<16-character app password>
#   MAIL_DEFAULT_SENDER=your-address@gmail.com
#
# Any standard SMTP provider works the same way (Mailtrap/Mailhog for
# local testing without sending real mail, SendGrid/Postmark/SES for
# production, etc) -- just point these at its SMTP endpoint.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# AI Farming Assistant (POST /api/ai/assistant). Not locked to one paid
# vendor -- AI_PROVIDER picks which one answers requests.
#
# "ollama" (default): a local, open-source model via Ollama
# (https://ollama.com). No API key, no external network call. Requires
# `ollama serve` running locally with AI_MODEL pulled, e.g.:
#   ollama pull llama3.2:1b
AI_PROVIDER=ollama
AI_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434

# "anthropic" (optional): Claude via the Anthropic API, for a hosted
# model in staging/production. To use it: set AI_PROVIDER=anthropic,
# AI_MODEL=claude-sonnet-5 (or another Claude model), and the key below.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# If AI_PROVIDER/AI_MODEL/the provider itself is unreachable or
# misconfigured, /api/ai/assistant responds 503 with a clear message --
# the rest of the app is unaffected either way.
