# Agricultural Super App — Docker Compose environment
# Copy to .env and set real values before running:
#   cp .env.example .env
#   docker compose up --build

# --- SECURITY (required in production) ---
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too-and-make-it-different

# --- AI ---
# Provider: "ollama" (local, default) or "anthropic" (requires API key)
AI_PROVIDER=ollama
# AI_MODEL=                  # Leave empty for provider default
# ANTHROPIC_API_KEY=          # Only needed if AI_PROVIDER=anthropic

# --- EMAIL ---
ADMIN_NOTIFICATION_EMAILS=

# --- Optional: override defaults ---
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agri_super_app
# FRONTEND_URL=http://localhost
